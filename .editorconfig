root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[{Makefile,*.mk,go.mod,*.go}]
indent_style = tab

# shfmt reads its indent from here; case bodies stay unindented, as in the
# guard scripts copied from xenolith.
[*.sh]
indent_size = 2
switch_case_indent = false
