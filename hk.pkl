amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

local all = (generated.steps) { ...generated.push }

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = generated.steps
  }
  // nix:V8: the message style, then the changelog rule. Only the message
  // says which kind a change is, so both live here, not in pre-commit.
  ["commit-msg"] {
    steps {
      ["commit-msg"] {
        check = "cargo run -q -p congestimancer-dev -- commit-msg {{commit_msg_file}}"
      }
      // After commit-msg, never beside it: two cargo runs at once contend
      // for the target directory lock (nix:V17).
      ["changelog-touched"] {
        check = "cargo run -q -p congestimancer-dev -- changelog {{commit_msg_file}}"
        depends = List("commit-msg")
      }
    }
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
}
