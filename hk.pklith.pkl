// generated by `pklith gen` from .pklith; do not edit
import "pkl/Config.pkl"

steps: Mapping<String, Config.Step> = new {
  ["trailing-whitespace"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'trailing-whitespace: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util trailing-whitespace --diff {{files}} || { echo 'trailing-whitespace: trailing blanks; the pre-commit hook strips them' >&2; exit 1; }"
    fix = "hk util trailing-whitespace --fix {{files}}"
  }
  ["final-newline"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'final-newline: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util end-of-file-fixer --diff {{files}} || { echo 'final-newline: file must end with a newline' >&2; exit 1; }"
    fix = "hk util end-of-file-fixer --fix {{files}}"
  }
  ["line-endings"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'line-endings: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util mixed-line-ending --diff {{files}} || { echo 'line-endings: file mixes CRLF and LF' >&2; exit 1; }"
    fix = "hk util mixed-line-ending --fix {{files}}"
  }
  ["no-bom"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-bom: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util check-byte-order-marker {{files}} || { echo 'no-bom: file starts with a byte order marker' >&2; exit 1; }"
  }
  ["no-merge-conflict"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-merge-conflict: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util check-merge-conflict --assume-in-merge {{files}} || { echo 'no-merge-conflict: leftover merge conflict markers' >&2; exit 1; }"
  }
  ["no-case-conflict"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-case-conflict: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util check-case-conflict {{files}} || { echo 'no-case-conflict: two paths differ only by case' >&2; exit 1; }"
  }
  ["no-broken-symlinks"] {
    check = "command -v git >/dev/null 2>&1 || { echo 'no-broken-symlinks: git is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; command -v hk >/dev/null 2>&1 || { echo 'no-broken-symlinks: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; git ls-files -z | xargs -0 hk util check-symlinks || { echo 'no-broken-symlinks: a symlink points nowhere' >&2; exit 1; }"
  }
  ["no-private-key"] {
    glob = List("**/*")
    check = "command -v hk >/dev/null 2>&1 || { echo 'no-private-key: hk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; hk util detect-private-key {{files}} || { echo 'no-private-key: a private key block is staged' >&2; exit 1; }"
  }
  ["ripsecrets"] {
    glob = List("**/*")
    check = "command -v ripsecrets >/dev/null 2>&1 || { echo 'ripsecrets: ripsecrets is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; ripsecrets {{files}} || { echo 'ripsecrets: a token or credential is staged; a false positive goes in .secretsignore' >&2; exit 1; }"
  }
  ["no-local-paths"] {
    glob = List("**/*")
    check = "command -v grep >/dev/null 2>&1 || { echo 'no-local-paths: grep is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; ! grep -nHE '/Users/[A-Za-z]|/home/|/root/' {{files}} /dev/null | grep -v nolocalpath || { echo 'no-local-paths: an absolute home path is staged; make it relative, or end the line with a nolocalpath comment' >&2; exit 1; }"
  }
  ["nixfmt"] {
    glob = List("**/*.nix")
    check = "command -v nixfmt >/dev/null 2>&1 || { echo 'nixfmt: nixfmt is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; nixfmt --check {{files}} || { echo 'nixfmt: nix file not formatted' >&2; exit 1; }"
    fix = "nixfmt {{files}}"
  }
  ["taplo"] {
    glob = List("**/*.toml")
    check = "command -v taplo >/dev/null 2>&1 || { echo 'taplo: taplo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; taplo fmt --check {{files}} || { echo 'taplo: TOML not formatted or not parseable' >&2; exit 1; }"
    fix = "taplo fmt {{files}}"
  }
  ["typos"] {
    glob = List("**/*")
    check = "command -v typos >/dev/null 2>&1 || { echo 'typos: typos is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; typos --force-exclude {{files}} || { echo 'typos: misspelling; fix it or teach .typos.toml' >&2; exit 1; }"
  }
  ["statix"] {
    glob = List("**/*.nix")
    check = #"command -v statix >/dev/null 2>&1 || { echo 'statix: statix is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; (for f in {{files}}; do statix check "$f" || exit 1; done) || { echo 'statix: nix anti-pattern; statix names the lint and its fix' >&2; exit 1; }"#
    fix = #"(for f in {{files}}; do statix fix "$f" || exit 1; done)"#
  }
  ["deadnix"] {
    glob = List("**/*.nix")
    check = "command -v deadnix >/dev/null 2>&1 || { echo 'deadnix: deadnix is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; deadnix --fail {{files}} || { echo 'deadnix: unused nix binding or argument; remove it, or prefix it with _' >&2; exit 1; }"
    fix = "deadnix --edit {{files}}"
  }
  ["markdownlint"] {
    glob = List("**/*.md")
    check = "command -v markdownlint >/dev/null 2>&1 || { echo 'markdownlint: markdownlint is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; markdownlint {{files}} || { echo 'markdownlint: markdown style finding; markdownlint names the rule' >&2; exit 1; }"
    fix = "markdownlint --fix {{files}}"
  }
  ["yamllint"] {
    glob = List("**/*.yml", "**/*.yaml")
    check = "command -v yamllint >/dev/null 2>&1 || { echo 'yamllint: yamllint is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; yamllint {{files}} || { echo 'yamllint: YAML error; yamllint names the rule' >&2; exit 1; }"
  }
  ["gawk-lint"] {
    glob = List("**/*.awk")
    check = #"command -v gawk >/dev/null 2>&1 || { echo 'gawk-lint: gawk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; (for f in {{files}}; do gawk --lint=fatal --pretty-print=/dev/null -f "$f" || exit 1; done) || { echo 'gawk-lint: awk script does not parse, or trips gawk'\''s lint' >&2; exit 1; }"#
  }
  ["editorconfig-checker"] {
    glob = List("**/*")
    check = "command -v editorconfig-checker >/dev/null 2>&1 || { echo 'editorconfig-checker: editorconfig-checker is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; editorconfig-checker {{files}} || { echo 'editorconfig-checker: file breaks its .editorconfig (indent, line ends, final newline)' >&2; exit 1; }"
  }
  ["lychee"] {
    glob = List("**/*.md")
    check = "command -v lychee >/dev/null 2>&1 || { echo 'lychee: lychee is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; lychee --offline --no-progress {{files}} || { echo 'lychee: a markdown link points at a file or anchor that does not exist; fix the link (offline: external URLs are not fetched)' >&2; exit 1; }"
  }
  ["ctrm"] {
    glob = List("**/*")
    check = "command -v ctrm >/dev/null 2>&1 || { echo 'ctrm: ctrm is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; ctrm check {{files}} || { echo 'ctrm: a file holds a character its set does not grant; fix it, or grant it in .ctrm and say why in the commit (nix:V12)' >&2; exit 1; }"
    fix = "ctrm fix {{files}}"
  }
  ["rekall"] {
    glob = List("AGENTS.md", "CLAUDE.md", "rekall.toml")
    check = "command -v rekall >/dev/null 2>&1 || { echo 'rekall: rekall is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; rekall check || { echo 'rekall: agent prose drifted from the rules rekall extracted from it; run rekall scan and settle the drift (nix:V14)' >&2; exit 1; }"
  }
  ["mth-fmt"] {
    glob = List("**/SPEC.md")
    check = #"command -v mth >/dev/null 2>&1 || { echo 'mth-fmt: mth is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; (for f in {{files}}; do mth fmt --check "$f" || exit 1; done) || { echo 'mth-fmt: SPEC.md is hard-wrapped or over the line cap' >&2; exit 1; }"#
    fix = #"(for f in {{files}}; do mth fmt "$f" || exit 1; done)"#
  }
  ["mth-check"] {
    glob = List("**/SPEC.md")
    check = #"command -v mth >/dev/null 2>&1 || { echo 'mth-check: mth is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; (for f in {{files}}; do mth check "$f" || exit 1; done) || { echo 'mth-check: SPEC.md breaks a structural rule' >&2; exit 1; }"#
  }
  ["sherd-check"] {
    glob = List("**/SPEC.md", "**/*.rs")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'sherd-check: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd check || { echo 'sherd-check: a citation across spec nodes does not resolve' >&2; exit 1; }"
  }
  ["sherd-nav"] {
    glob = List("**/SPEC.md")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'sherd-nav: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd sync --check || { echo 'sherd-nav: a §N table is stale' >&2; exit 1; }"
    fix = "sherd sync"
  }
  ["sherd-budget"] {
    glob = List("**/SPEC.md", ".context-limits")
    check = "command -v sherd >/dev/null 2>&1 || { echo 'sherd-budget: sherd is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; sherd budget || { echo 'sherd-budget: a spec chain is over its ceiling' >&2; exit 1; }"
  }
  ["itok"] {
    glob = List("**/*", ".context-limits")
    check = "command -v itok >/dev/null 2>&1 || { echo 'itok: itok is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; itok check || { echo 'itok: a file registered in .context-limits is over its token ceiling' >&2; exit 1; }"
  }
  ["spec-records"] {
    glob = List("SPEC.md", ".spec-records")
    check = "command -v mth >/dev/null 2>&1 || { echo 'spec-records: mth is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; mth check --records .spec-records SPEC.md || { echo 'spec-records: a rejected option recorded in .spec-records was edited out of SPEC.md; restore the record or remove it from .spec-records in its own reviewed commit' >&2; exit 1; }"
  }
  ["ceiling-cap"] {
    glob = List(".context-limits", "nix/ceiling-cap.awk")
    check = "command -v awk >/dev/null 2>&1 || { echo 'ceiling-cap: awk is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; awk -f nix/ceiling-cap.awk .context-limits || { echo 'ceiling-cap: a .context-limits ceiling is over its cap (SPEC.md file 3500, chain 5500); split the node with sherd split instead of raising (nix:V3)' >&2; exit 1; }"
  }
  ["gen-check"] {
    glob = List(".pklith", "hk.pklith.pkl", "nix/pklith.nix")
    check = "command -v pklith >/dev/null 2>&1 || { echo 'gen-check: pklith is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; pklith gen --check || { echo 'gen-check: hk.pklith.pkl or nix/pklith.nix no longer matches .pklith; run pklith gen' >&2; exit 1; }"
    fix = "pklith gen"
  }
}

push: Mapping<String, Config.Step> = new {
  ["pklith-check"] {
    glob = List("**/*")
    check = "command -v pklith >/dev/null 2>&1 || { echo 'pklith-check: pklith is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; pklith check || { echo 'pklith-check: a tracked file type has no row in .pklith, a row matches nothing, or a claimed check never reaches its files' >&2; exit 1; }"
  }
}
