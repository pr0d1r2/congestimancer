push: Mapping<String, Config.Step> = new {
  ["cargo-test"] {
    glob = List("**/*.rs", "Cargo.toml", "Cargo.lock", "dev/Cargo.toml")
    check = "command -v cargo >/dev/null 2>&1 || { echo 'cargo-test: cargo is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; cargo test --workspace --quiet || { echo 'cargo-test: a test fails; fix the code or, if the spec changed, backprop it first' >&2; exit 1; }"
  }
  ["tdd-order"] {
    glob = List("**/*.rs", "nix/guard/tdd-order.sh", "nix/guard/tdd-order.exempt")
    check = "command -v bash >/dev/null 2>&1 || { echo 'tdd-order: bash is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; bash nix/guard/tdd-order.sh || { echo 'tdd-order: a commit adds Rust code with no test: commit before it in the push range (nix:V7)' >&2; exit 1; }"
  }
  ["coverage"] {
    glob = List("**/*.rs", ".coverage", "nix/guard/coverage.sh")
    check = "command -v bash >/dev/null 2>&1 || { echo 'coverage: bash is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; bash nix/guard/coverage.sh || { echo 'coverage: line coverage is below the floor, or .coverage overstates or lags the measurement (nix:V5)' >&2; exit 1; }"
    fix = "bash nix/guard/coverage.sh --fix"
  }
  ["pklith-check"] {
    glob = List("**/*")
    check = "command -v pklith >/dev/null 2>&1 || { echo 'pklith-check: pklith is not on PATH; re-enter the dev shell. A MISSING TOOL, not a finding.' >&2; exit 1; }; pklith check || { echo 'pklith-check: a tracked file type has no row in .pklith, a row matches nothing, or a claimed check never reaches its files' >&2; exit 1; }"
  }
}
